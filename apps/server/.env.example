NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anyhunt
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anyhunt_shadow
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
ANYHUNT_WWW_URL=http://localhost:3001
ADMIN_EMAILS=admin@example.com
TRUST_PROXY=false

# Base64-encoded 32-byte key used to encrypt stored LLM credentials.
ANYHUNT_LLM_SECRET_KEY=
DEFAULT_LLM_DIGEST_MODEL_ID=

SEARXNG_URL=http://localhost:8080
SEARCH_CONCURRENCY=3
SEARCH_RETRY_COUNT=2
SEARCH_RETRY_DELAY=1000
MAP_MAX_CRAWL_PAGES=50
SCRAPE_CACHE_TTL_MS=3600000
BROWSER_POOL_SIZE=2
BROWSER_WARMUP_COUNT=1
BROWSER_IDLE_TIMEOUT=300000
MAX_PAGES_PER_BROWSER=100

RESEND_API_KEY=
EMAIL_FROM=Anyhunt <digest@example.com>
CREEM_WEBHOOK_SECRET=
WEBHOOK_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
