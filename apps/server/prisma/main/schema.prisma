// Anyhunt 1.0 main database schema.
// The schema contains the nine product models and the minimum supporting models.

generator client {
  provider   = "prisma-client"
  output     = "../../generated/prisma-main"
  outputType = "commonjs"
}

datasource db {
  provider = "postgresql"
}

// Authentication and user support

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions             Session[]
  refreshTokens        RefreshToken[]
  accounts             Account[]
  topics               Topic[]         @relation("TopicOwner")
  subscriptions        Subscription[]
  skills               Skill[]         @relation("SkillOwner")
  itemStates           UserItemState[]
  topicReports         TopicReport[]   @relation("TopicReporter")
  resolvedTopicReports TopicReport[]   @relation("TopicReportResolver")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacements RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AccountDeletionRecord {
  id         String   @id @default(cuid())
  userIdHash String   @unique
  emailHash  String
  reason     String
  feedback   String?
  deletedAt  DateTime @default(now())

  @@index([reason])
  @@index([deletedAt])
}

// Product domain

enum TopicVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum TopicStatus {
  ACTIVE
  SUSPENDED
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  EMPTY
  FAILED
  CANCELED
}

enum RunTrigger {
  INITIAL
  SCHEDULED
  MANUAL
}

enum DeliveryChannel {
  EMAIL
  WEBHOOK
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum TopicReportReason {
  SPAM
  COPYRIGHT
  INAPPROPRIATE
  MISLEADING
  OTHER
}

enum TopicReportStatus {
  PENDING
  RESOLVED_VALID
  RESOLVED_INVALID
  DISMISSED
}

model Topic {
  id             String          @id @default(cuid())
  ownerId        String
  slug           String          @unique
  title          String
  goal           String
  description    String?
  visibility     TopicVisibility @default(PRIVATE)
  status         TopicStatus     @default(ACTIVE)
  locale         String          @default("en")
  cron           String
  timezone       String
  enabled        Boolean         @default(true)
  managedSkillId String?
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  owner          User           @relation("TopicOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  managedSkill   Skill?         @relation("ManagedTopicSkill", fields: [managedSkillId], references: [id], onDelete: SetNull)
  attachedSkills Skill[]        @relation("AttachedTopicSkills")
  subscriptions  Subscription[]
  runs           Run[]
  reports        TopicReport[]

  @@index([ownerId, createdAt])
  @@index([visibility, status])
  @@index([enabled, status, nextRunAt])
  @@index([managedSkillId])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  topicId                String
  enabled                Boolean   @default(true)
  subscribedAt           DateTime  @default(now())
  canceledAt             DateTime?
  inboxEnabled           Boolean   @default(true)
  emailEnabled           Boolean   @default(false)
  webhookEnabled         Boolean   @default(false)
  webhookUrl             String?
  webhookSecretEncrypted String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@unique([userId, topicId])
  @@index([topicId, enabled])
  @@index([userId, enabled])
}

model Skill {
  id             String    @id @default(cuid())
  ownerId        String
  name           String
  description    String
  enabled        Boolean   @default(false)
  currentVersion Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          User           @relation("SkillOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions       SkillVersion[]
  managedTopics  Topic[]        @relation("ManagedTopicSkill")
  attachedTopics Topic[]        @relation("AttachedTopicSkills")

  @@index([ownerId, enabled])
}

model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  version     Int
  files       Json
  contentHash String
  sourceUrl   String?
  createdAt   DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@unique([skillId, contentHash])
  @@index([skillId, createdAt])
}

model Run {
  id                String     @id @default(cuid())
  topicId           String
  runKey            String     @unique
  status            RunStatus  @default(QUEUED)
  trigger           RunTrigger
  scheduledAt       DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  canceledAt        DateTime?
  checkpoint        Json?
  runtimeStats      Json?
  narrative         String?
  emptyReason       String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  items      RunItem[]
  deliveries Delivery[]

  @@index([topicId, scheduledAt])
  @@index([status, scheduledAt])
}

model RunItem {
  id               String   @id @default(cuid())
  runId            String
  canonicalUrlHash String
  title            String
  url              String
  summary          String
  selectionReason  String
  rank             Int
  retrievedAt      DateTime
  sourceTitle      String?
  contentHash      String
  createdAt        DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, canonicalUrlHash])
  @@index([canonicalUrlHash])
  @@index([runId, rank])
}

model UserItemState {
  id               String    @id @default(cuid())
  userId           String
  canonicalUrlHash String
  readAt           DateTime?
  savedAt          DateTime?
  notInterestedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalUrlHash])
  @@index([userId, savedAt])
}

model Delivery {
  id             String          @id @default(cuid())
  runId          String
  subscriptionId String
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  attemptCount   Int             @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  run          Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([runId, subscriptionId, channel])
  @@index([status, createdAt])
  @@index([subscriptionId, createdAt])
}

model TopicReport {
  id             String            @id @default(cuid())
  topicId        String
  reporterUserId String
  reason         TopicReportReason
  description    String?
  status         TopicReportStatus @default(PENDING)
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  topic      Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reporter   User  @relation("TopicReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("TopicReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([topicId, reporterUserId])
  @@index([status, createdAt])
  @@index([reporterUserId])
}

// Operational support

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  targetUserId String?
  action       String
  reason       String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

model RequestLog {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  requestId          String?
  method             String
  path               String
  routeGroup         String?
  statusCode         Int
  durationMs         Int
  authType           String?
  userId             String?
  clientIp           String
  forwardedFor       String?
  origin             String?
  referer            String?
  userAgent          String?
  errorCode          String?
  errorMessage       String?
  retryAfter         String?
  rateLimitLimit     String?
  rateLimitRemaining String?
  rateLimitReset     String?
  requestBytes       Int?
  responseBytes      Int?

  @@index([createdAt])
  @@index([requestId])
  @@index([statusCode, createdAt])
  @@index([routeGroup, createdAt])
  @@index([userId, createdAt])
  @@index([clientIp, createdAt])
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  scope          String
  idempotencyKey String
  method         String
  path           String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  resourceType   String?
  resourceId     String?
  errorCode      String?
  expiresAt      DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([scope, idempotencyKey])
  @@index([expiresAt])
  @@index([status, createdAt])
}

model LlmProvider {
  id              String   @id @default(cuid())
  providerType    String
  name            String
  apiKeyEncrypted String
  baseUrl         String?
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  models LlmModel[]

  @@index([enabled])
  @@index([providerType])
}

model LlmModel {
  id               String   @id @default(cuid())
  providerId       String
  modelId          String
  upstreamId       String
  displayName      String
  enabled          Boolean  @default(true)
  inputTokenPrice  Float
  outputTokenPrice Float
  maxContextTokens Int
  maxOutputTokens  Int
  capabilitiesJson Json
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@index([providerId])
  @@index([enabled])
  @@index([modelId])
}

model LlmSettings {
  id                  String   @id @default("default")
  defaultAgentModelId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
