{
  "name": "anyhunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anyhunt turns topics into recurring AI-curated digests.",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "dev:server": "pnpm --filter @anyhunt/server start:dev",
    "dev:web": "pnpm --filter @anyhunt/web dev",
    "dev:admin": "pnpm --filter @anyhunt/admin dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsc-multi": "^1.1.0",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@prisma/adapter-pg": "7.2.0",
      "@prisma/client": "7.2.0",
      "prisma": "7.2.0",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
