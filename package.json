{
  "name": "anyhunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anyhunt turns topics into recurring AI-curated digests.",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "dev:server": "pnpm --filter \"@anyhunt/server^...\" --if-present build && pnpm --filter @anyhunt/server start:dev",
    "dev:web": "pnpm --filter \"@anyhunt/web^...\" --if-present build && pnpm --filter @anyhunt/web dev",
    "dev:admin": "pnpm --filter \"@anyhunt/admin^...\" --if-present build && pnpm --filter @anyhunt/admin dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v --remove-orphans",
    "docker:smoke": "docker compose run --rm smoke",
    "test:browser": "chrome-use test tests/browser/anyhunt-1.0.yaml --launch",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsc-multi": "^1.1.0",
    "turbo": "^2.4.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "@prisma/adapter-pg": "7.2.0",
      "@prisma/client": "7.2.0",
      "dompurify": "3.4.13",
      "effect": "3.20.0",
      "hono": "4.12.34",
      "js-yaml@5.2.1": "5.2.2",
      "lodash": "4.18.1",
      "mermaid": "11.16.1",
      "nanoid@<3.3.17": "3.3.17",
      "prisma": "7.2.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "valibot": "1.4.2"
    }
  }
}
